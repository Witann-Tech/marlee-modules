<odoo>
    <record id="view_purchase_order_cash" model="ir.ui.view">
        <field name="name">purchase.order.pos.cash</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Efectivo POS" groups="account.group_account_user">
                    <div class="alert alert-info" role="alert">
                        Las salidas vinculadas se aplican automáticamente al publicar sus facturas de proveedor.
                        Para facturas ya publicadas o después de deshacer una aplicación, usa el botón de esta pestaña.
                    </div>
                    <button name="action_witann_apply_cash" type="object" string="Aplicar a facturas publicadas"
                            class="oe_highlight" invisible="state != 'purchase'"/>
                    <field name="witann_cash_link_ids" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="statement_line_id" string="Salida de efectivo"/>
                            <field name="source_company_id"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="amount" sum="Reservado"/>
                            <field name="applied_amount" sum="Aplicado"/>
                            <field name="remaining_amount" sum="Por aplicar"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
