<odoo>
    <record id="view_cash_out_list" model="ir.ui.view">
        <field name="name">account.bank.statement.line.pos.cash.vendor.list</field>
        <field name="model">account.bank.statement.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-success="witann_vendor_reconciliation_state == 'reconciled'">
                <field name="date"/>
                <field name="pos_session_id"/>
                <field name="payment_ref"/>
                <field name="journal_id"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount" sum="Total salidas"/>
                <field name="witann_purchase_order_id" optional="show"/>
                <field name="witann_purchase_remaining_amount" optional="show" sum="Reservado por aplicar"/>
                <field name="witann_vendor_bill_ids" widget="many2many_tags"/>
                <field name="witann_vendor_reconciliation_state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <button name="action_witann_reconcile_vendor" type="object" string="Conciliar" icon="fa-check"
                        groups="account.group_account_user" invisible="witann_vendor_reconciliation_state != 'pending'"/>
            </list>
        </field>
    </record>
    <record id="view_cash_out_form" model="ir.ui.view">
        <field name="name">account.bank.statement.line.pos.cash.vendor.form</field>
        <field name="model">account.bank.statement.line</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_witann_reconcile_vendor" type="object" string="Conciliar con proveedor"
                            class="oe_highlight" groups="account.group_account_user"
                            invisible="witann_vendor_reconciliation_state != 'pending'"/>
                    <button name="action_witann_undo_vendor_reconciliation" type="object" string="Deshacer conciliación"
                            groups="account.group_account_user" invisible="not witann_vendor_bill_ids and not (witann_purchase_order_id and witann_vendor_reconciliation_state == 'other')"
                            confirm="Se reabrirán los saldos aplicados. Si hay una OC vinculada, el efectivo volverá a quedar reservado para ella. ¿Continuar?"/>
                    <button name="action_witann_link_purchase" type="object" string="Vincular con OC"
                            groups="account.group_account_user" invisible="witann_vendor_reconciliation_state != 'pending'"/>
                    <button name="action_witann_apply_purchase" type="object" string="Aplicar a facturas publicadas"
                            groups="account.group_account_user" invisible="witann_vendor_reconciliation_state not in ('reserved', 'partial')"/>
                    <button name="action_witann_unlink_purchase" type="object" string="Desvincular OC"
                            groups="account.group_account_user" invisible="witann_vendor_reconciliation_state != 'reserved'"
                            confirm="Se liberará la reserva para poder asignar la salida a otro destino. ¿Continuar?"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="pos_session_id"/>
                            <field name="payment_ref"/>
                            <field name="journal_id"/>
                            <field name="move_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                            <field name="amount"/>
                            <field name="witann_vendor_reconciliation_state" widget="badge"/>
                            <field name="witann_purchase_order_id" invisible="not witann_purchase_order_id"/>
                            <field name="witann_purchase_applied_amount" invisible="not witann_purchase_order_id"/>
                            <field name="witann_purchase_remaining_amount" invisible="not witann_purchase_order_id"/>
                        </group>
                    </group>
                    <field name="witann_vendor_bill_ids">
                        <list create="0" edit="0" delete="0">
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="ref"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="amount_total"/>
                            <field name="amount_residual"/>
                            <field name="payment_state" widget="badge"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_cash_out_search" model="ir.ui.view">
        <field name="name">account.bank.statement.line.pos.cash.vendor.search</field>
        <field name="model">account.bank.statement.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="payment_ref"/>
                <field name="pos_session_id"/>
                <field name="journal_id"/>
                <field name="witann_purchase_order_id"/>
                <filter name="pending" string="Pendientes de aplicar" domain="[('witann_vendor_reconciliation_state', 'in', ['pending', 'reserved', 'partial'])]"/>
                <filter name="reconciled" string="Conciliadas con proveedor" domain="[('witann_vendor_reconciliation_state', '=', 'reconciled')]"/>
                <filter name="reserved" string="Reservadas para OC" domain="[('witann_vendor_reconciliation_state', 'in', ['reserved', 'partial'])]"/>
                <filter name="other" string="Revisar / otro destino" domain="[('witann_vendor_reconciliation_state', '=', 'other')]"/>
                <separator/>
                <filter name="date" string="Fecha de salida" date="date"/>
                <group>
                    <filter name="session" string="Sesión POS" context="{'group_by': 'pos_session_id'}"/>
                    <filter name="journal" string="Diario de caja" context="{'group_by': 'journal_id'}"/>
                    <filter name="company" string="Empresa" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_cash_out" model="ir.actions.act_window">
        <field name="name">Salidas de efectivo a proveedores</field>
        <field name="res_model">account.bank.statement.line</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_cash_out_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_cash_out_form')})]"/>
        <field name="search_view_id" ref="view_cash_out_search"/>
        <field name="domain">[('pos_session_id', '!=', False), ('amount', '&lt;', 0), ('journal_id.type', '=', 'cash')]</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No hay salidas de efectivo pendientes.</p>
            <p>Registra una salida manual en el POS para aplicarla a facturas de proveedor.</p>
        </field>
    </record>
    <menuitem id="menu_cash_out_pos" name="Salidas de efectivo a proveedores"
              parent="point_of_sale.menu_point_rep" action="action_cash_out"
              groups="account.group_account_user" sequence="30"/>
    <menuitem id="menu_cash_out_account" name="Salidas de efectivo POS"
              parent="account.menu_finance_payables" action="action_cash_out"
              groups="account.group_account_user" sequence="25"/>
</odoo>
