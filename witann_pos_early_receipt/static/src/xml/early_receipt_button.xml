<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
  <t t-name="witann_pos_early_receipt.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
    <xpath expr="//t[@t-if='props.showRemainingButtons']/div/NoteButton" position="after">
      <button t-if="pos.config.wgs_early_receipt_printing"
              t-att-class="buttonClass"
              t-att-disabled="!wgsCanPrintEarlyReceipt"
              t-on-click="onWgsPrintEarlyReceipt">
        <i t-if="wgsEarlyReceiptState.printing" class="fa fa-spinner fa-spin me-1"/>
        <i t-else="" class="fa fa-print me-1"/>
        <t t-if="wgsEarlyReceiptState.printing">Imprimiendo...</t>
        <t t-else="">Imprimir precuenta</t>
      </button>
    </xpath>
  </t>
</templates>
