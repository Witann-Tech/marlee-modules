<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_form_pos_commission" model="ir.ui.view">
        <field name="name">hr.employee.form.pos.commission</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page name="witann_pos_commission" string="Comisión POS" groups="hr_payroll.group_hr_payroll_user"
                      invisible="not witann_pos_commission_eligible">
                    <field name="witann_pos_commission_eligible" invisible="1"/>
                    <group>
                        <field name="witann_pos_commission_rate"/>
                    </group>
                    <p>1% mensual equivale a 0.5% en cada quincena sobre las ventas sin impuestos del mes anterior.
                       Un porcentaje de 0 desactiva la comisión. Las ventas se identifican por el usuario vinculado al empleado.</p>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
